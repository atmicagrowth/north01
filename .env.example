# NORTH / 01 - environment template. Copy to `.env` and fill in.
#
# `.env` is git-ignored and must never be committed. This file holds NAMES ONLY - never paste a
# real value here, not even a test-mode one.
#
# The schema that validates all of this lives in `src/lib/env.core.ts` (server-only) and
# `src/lib/env.public.ts` (browser-safe); application code imports `src/lib/env.server.ts`. Full
# documentation - where each value comes from and which environments require it - is in
# `docs/ENVIRONMENT.md`.
#
# Only the first two variables are required. DATABASE_PUSH_TARGET below them is needed now for local
# schema work (Phase 4). Everything after that belongs to a later phase and is optional until that
# phase lands; each block is annotated with the phase that turns it on.
#
# Anything prefixed NEXT_PUBLIC_ is compiled into the JavaScript sent to browsers. The prefix is
# a decision to publish the value. Never use it for a secret.
#
# Note that `.env.local`, if you create one, overrides this file for `next build` and
# `next start` as well as `next dev` - not only in development.


# =============================================================================
# REQUIRED
# =============================================================================

# ---- Payload ----
# Server-only. Signs and encrypts Payload session tokens and field-level encryption.
# Minimum 32 characters. Use a different value in every environment.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# ---- Database ----
# Server-only. Neon Postgres connection string for THIS environment.
#
# Development must point at a development branch, never at production.
#
# Use the DIRECT (non-pooled) endpoint locally and the POOLED (-pooler) endpoint in a deployed
# environment - serverless means many processes, each holding its own connection pool. Use
# sslmode=verify-full, not sslmode=require.
# pg 8.x treats them identically today, but pg 9 adopts libpq semantics where `require` skips
# certificate verification. Spelling it out now means the connection does not silently weaken on
# a future upgrade.
#
#   postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=verify-full
DATABASE_URL=


# =============================================================================
# LOCAL DEVELOPMENT
# =============================================================================

# ---- Schema push guard (Phase 4, decision D-10) ----
# Server-only, local development only.
#
# The ONE database Drizzle's development schema push may modify, written as `host[:port]/database`
# - the host and database from DATABASE_URL, with credentials dropped. The port defaults to 5432:
#
#   ep-cool-name-123456.us-east-2.aws.neon.tech/neondb
#
# Paste the host and database only. A full connection string is rejected: it would put credentials
# into a log line.
#
# Push rewrites the schema of whatever DATABASE_URL points at. Naming the permitted target
# separately means that repointing DATABASE_URL DISARMS push instead of aiming it at the new
# database - re-arming is a deliberate second edit.
#
# Fail-closed: leave this unset and push never runs, which also means /admin cannot create the
# schema on a fresh database. `pnpm dev` tells you when that is the case.
#
# Only relevant locally. Push cannot run in preview or production at all.
DATABASE_PUSH_TARGET=

# ---- Canonical origin ---- (read from Phase 7)
# Server-only. The deployment's own origin, no trailing slash. Used for the password-reset link in
# email (Phase 7), Stripe redirect URLs (Phase 17), canonical tags and the sitemap (Phase 24), and
# set on the Payload config as `serverURL`.
#
# It is deliberately NOT derived from the request's Host header: a reset link built from a header an
# attacker controls is a reset token delivered to the attacker. Unset, it falls back to Vercel's
# VERCEL_PROJECT_PRODUCTION_URL and then to http://localhost:3000 — so set it if you run the dev
# server on any other port, or the link in the log will point at the wrong one.
#   http://localhost:3000
SITE_URL=http://localhost:3000


# =============================================================================
# OPTIONAL INTEGRATIONS - each is off until its phase lands
#
# A group is all-or-nothing. Filling in some of a provider's keys but not the rest is reported
# as a warning at every startup and the integration is treated as unavailable.
#
# Two variables sit outside that rule on purpose: SENTRY_AUTH_TOKEN, which the build uses to upload
# source maps and which is absent at runtime by design, and POSTHOG_API_KEY, which is an optional
# extra even when PostHog is configured.
# =============================================================================

# ---- Cloudinary ---- (Phase 8 - read now)
# Media delivery and every crop/resize. Cloud name is public - it is a path segment of every image URL,
# which is why it is NEXT_PUBLIC_. The key and secret are server-only and are read by exactly one file,
# src/payload/storage/cloudinary.ts.
# Source: Cloudinary Console -> Dashboard -> API Keys / Product Environment Credentials.
# Separate environments by folder or upload preset, not by account. This project uploads into `north01/`.
#
# Leave all three blank and the app still runs: uploads fall back to local disk and the storefront
# renders each image as its deliberate placeholder. That is correct for development and WRONG for any
# deployed environment, whose filesystem is ephemeral - the app warns at startup if it finds itself in
# that state outside local development.
#
# Do NOT set CLOUDINARY_URL, CLOUDINARY_ACCOUNT_URL or CLOUDINARY_API_PROXY. The SDK reads all three
# straight from process.env behind the app's back, and CLOUDINARY_URL carries an API secret; the
# environment schema refuses them and will fail startup with a message naming these three instead.
#
# After setting them: `pnpm verify:media` runs a live upload/derive/delete round trip.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Algolia ---- (Phase 11 — pulled forward from Phase 12)
# Search. Use a DEVELOPMENT index locally, never the production one.
# Source: Algolia Dashboard -> API Keys. All three are on the signup screen; a new
# application needs no further setup, because indices are created on first write.
#
# The Search API Key is safe to publish and is read-only (a write through it is 403).
# The WRITE API Key is not publishable. It is deliberately NOT the Admin key: Algolia
# pre-creates a write-scoped key that can add/delete objects, edit settings and delete
# indices, but CANNOT list or mint API keys. Verified against a live app - GET /1/keys
# returns 403 with it. Never substitute the Admin key here; it is account-root.
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=
ALGOLIA_WRITE_API_KEY=

# ---- Stripe ---- (Phase 17)
# TEST MODE ONLY. Live credentials outside production are a hard startup error, not a warning.
# Source: Stripe Dashboard -> Developers -> API keys, and -> Webhooks for the signing secret.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Resend ---- (Phase 19)
# Transactional email. A verified sending domain is required before any production send.
# Source: Resend -> API Keys.
RESEND_API_KEY=

# ---- Sentry ---- (Phase 25)
# Error monitoring. A DSN is public by design; the auth token is build-time only, for source maps.
# Source: Sentry -> Project Settings -> Client Keys, and -> Auth Tokens.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ---- PostHog ---- (Phase 25)
# Product analytics. Source: PostHog -> Project Settings.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
POSTHOG_API_KEY=

# ---- Google Analytics 4 ---- (Phase 25)
# Source: GA4 -> Admin -> Data Streams. Looks like G-XXXXXXXXXX.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---- Cloudflare Turnstile ---- (Phase 26)
# Bot protection on public forms. Source: Cloudflare Dashboard -> Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
