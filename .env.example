# NORTH / 01 - environment template. Copy to `.env` and fill in.
#
# `.env` is git-ignored and must never be committed. The full environment schema and its
# runtime validation are defined in Phase 4; these are the two variables the Phase 2
# foundation cannot boot without.

# ---- Payload ----
# Server-only. Signs and encrypts Payload session tokens and field-level encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# ---- Database ----
# Server-only. Neon Postgres connection string for THIS environment.
# Development must point at a development branch, never at production.
DATABASE_URL=
