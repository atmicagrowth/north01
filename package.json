{
  "name": "north01",
  "version": "0.1.0",
  "private": true,
  "description": "NORTH / 01 — online-only DTC premium apparel storefront",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:deploy": "payload migrate && next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "payload": "payload",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:status": "payload migrate:status",
    "migrate:down": "payload migrate:down",
    "migrate:fresh": "payload migrate:fresh",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "seed": "payload run scripts/seed.ts",
    "generate:media": "payload run scripts/generate-media.ts",
    "import:media": "payload run scripts/import-brand-media.ts",
    "email:drain": "payload run scripts/drain-email.ts",
    "email:preview": "email dev --dir src/emails --port 3030",
    "verify:access": "payload run scripts/verify-access.ts",
    "verify:media": "payload run scripts/verify-media.ts",
    "verify:shell": "payload run scripts/verify-shell.ts",
    "verify:home": "payload run scripts/verify-home.ts",
    "verify:catalog": "payload run scripts/verify-catalog.ts",
    "reindex": "payload run scripts/reindex.ts",
    "reindex:check": "payload run scripts/reindex-check.ts",
    "verify:search": "payload run scripts/verify-search.ts",
    "verify:product": "payload run scripts/verify-product.ts",
    "verify:cart": "payload run scripts/verify-cart.ts",
    "verify:promotions": "payload run scripts/verify-promotions.ts",
    "verify:shipping": "payload run scripts/verify-shipping.ts",
    "verify:checkout": "payload run scripts/verify-checkout.ts",
    "verify:webhook": "payload run scripts/verify-webhook.ts",
    "verify:email": "payload run scripts/verify-email.ts",
    "verify:orders": "payload run scripts/verify-orders.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/plugin-cloud-storage": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@react-email/components": "1.0.12",
    "algoliasearch": "5.57.0",
    "class-variance-authority": "0.7.1",
    "cloudinary": "2.10.1",
    "clsx": "2.1.1",
    "graphql": "16.14.2",
    "lucide-react": "1.33.0",
    "next": "16.3.2",
    "nuqs": "2.10.1",
    "payload": "3.88.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.22.0",
    "stripe": "22.5.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "prettier": "3.9.6",
    "react-email": "6.9.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
