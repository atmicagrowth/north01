# Normalize line endings: LF in the repository, native in the working tree.
* text=auto eol=lf

# Windows-native scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets - never diff or normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.avif binary
*.ico  binary
*.mp4  binary
*.webm binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.pdf  binary

# Generated - collapse in diffs and exclude from language stats.
pnpm-lock.yaml -diff linguist-generated=true
src/payload-types.ts -diff linguist-generated=true
